{
  "AnalyzeRequest": {
    "description": "Pertanyaan analitik dari user terhadap sebuah dataset.",
    "properties": {
      "question": {
        "minLength": 1,
        "title": "Question",
        "type": "string"
      },
      "dataset_id": {
        "minLength": 1,
        "title": "Dataset Id",
        "type": "string"
      },
      "session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Session Id"
      }
    },
    "required": [
      "question",
      "dataset_id"
    ],
    "title": "AnalyzeRequest",
    "type": "object"
  },
  "PlanStep": {
    "description": "Satu langkah eksplisit dari planner. Juga menyetir progress bar UI.",
    "properties": {
      "id": {
        "title": "Id",
        "type": "integer"
      },
      "description": {
        "title": "Description",
        "type": "string"
      },
      "tool": {
        "title": "Tool",
        "type": "string"
      },
      "status": {
        "default": "pending",
        "enum": [
          "pending",
          "running",
          "done",
          "error"
        ],
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "id",
      "description",
      "tool"
    ],
    "title": "PlanStep",
    "type": "object"
  },
  "ToolCall": {
    "description": "Catatan satu pemanggilan tool (untuk execution trace / 'show your work').",
    "properties": {
      "tool": {
        "title": "Tool",
        "type": "string"
      },
      "input": {
        "title": "Input",
        "type": "object"
      },
      "output": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Output"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      },
      "duration_ms": {
        "default": 0,
        "title": "Duration Ms",
        "type": "integer"
      }
    },
    "required": [
      "tool"
    ],
    "title": "ToolCall",
    "type": "object"
  },
  "VerificationResult": {
    "description": "Hasil self-verify: angka kunci dihitung 2 metode lalu dibandingkan.",
    "properties": {
      "method_a": {
        "title": "Method A",
        "type": "string"
      },
      "method_b": {
        "title": "Method B",
        "type": "string"
      },
      "agreement": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Agreement",
        "type": "number"
      },
      "contradictions": {
        "items": {
          "type": "string"
        },
        "title": "Contradictions",
        "type": "array"
      },
      "passed": {
        "title": "Passed",
        "type": "boolean"
      }
    },
    "required": [
      "method_a",
      "method_b",
      "agreement",
      "passed"
    ],
    "title": "VerificationResult",
    "type": "object"
  },
  "ConfidenceBreakdown": {
    "description": "Computed confidence (Blueprint \u00a74.5) \u2014 BUKAN tebakan LLM.\n\nfinal = 0.40*answer_consistency + 0.30*verification_agreement\n      + 0.20*tool_execution_success + 0.10*data_coverage",
    "properties": {
      "answer_consistency": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Answer Consistency",
        "type": "number"
      },
      "verification_agreement": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Verification Agreement",
        "type": "number"
      },
      "tool_execution_success": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Tool Execution Success",
        "type": "number"
      },
      "data_coverage": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Data Coverage",
        "type": "number"
      },
      "final": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Final",
        "type": "number"
      },
      "label": {
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW"
        ],
        "title": "Label",
        "type": "string"
      }
    },
    "required": [
      "answer_consistency",
      "verification_agreement",
      "tool_execution_success",
      "data_coverage",
      "final",
      "label"
    ],
    "title": "ConfidenceBreakdown",
    "type": "object"
  },
  "AnalysisResult": {
    "$defs": {
      "ConfidenceBreakdown": {
        "description": "Computed confidence (Blueprint \u00a74.5) \u2014 BUKAN tebakan LLM.\n\nfinal = 0.40*answer_consistency + 0.30*verification_agreement\n      + 0.20*tool_execution_success + 0.10*data_coverage",
        "properties": {
          "answer_consistency": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Answer Consistency",
            "type": "number"
          },
          "verification_agreement": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Verification Agreement",
            "type": "number"
          },
          "tool_execution_success": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Tool Execution Success",
            "type": "number"
          },
          "data_coverage": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Data Coverage",
            "type": "number"
          },
          "final": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Final",
            "type": "number"
          },
          "label": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ],
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "answer_consistency",
          "verification_agreement",
          "tool_execution_success",
          "data_coverage",
          "final",
          "label"
        ],
        "title": "ConfidenceBreakdown",
        "type": "object"
      },
      "ToolCall": {
        "description": "Catatan satu pemanggilan tool (untuk execution trace / 'show your work').",
        "properties": {
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "input": {
            "title": "Input",
            "type": "object"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Output"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error"
          },
          "duration_ms": {
            "default": 0,
            "title": "Duration Ms",
            "type": "integer"
          }
        },
        "required": [
          "tool"
        ],
        "title": "ToolCall",
        "type": "object"
      },
      "VerificationResult": {
        "description": "Hasil self-verify: angka kunci dihitung 2 metode lalu dibandingkan.",
        "properties": {
          "method_a": {
            "title": "Method A",
            "type": "string"
          },
          "method_b": {
            "title": "Method B",
            "type": "string"
          },
          "agreement": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Agreement",
            "type": "number"
          },
          "contradictions": {
            "items": {
              "type": "string"
            },
            "title": "Contradictions",
            "type": "array"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          }
        },
        "required": [
          "method_a",
          "method_b",
          "agreement",
          "passed"
        ],
        "title": "VerificationResult",
        "type": "object"
      }
    },
    "description": "Bundle lengkap satu run: jawaban + kode + chart + verifikasi + confidence.",
    "properties": {
      "run_id": {
        "title": "Run Id",
        "type": "string"
      },
      "answer_markdown": {
        "title": "Answer Markdown",
        "type": "string"
      },
      "code": {
        "title": "Code",
        "type": "string"
      },
      "dataset_id": {
        "default": "",
        "title": "Dataset Id",
        "type": "string"
      },
      "dataset_snapshot": {
        "default": "",
        "title": "Dataset Snapshot",
        "type": "string"
      },
      "chart_paths": {
        "items": {
          "type": "string"
        },
        "title": "Chart Paths",
        "type": "array"
      },
      "verification": {
        "anyOf": [
          {
            "$ref": "#/$defs/VerificationResult"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "confidence": {
        "anyOf": [
          {
            "$ref": "#/$defs/ConfidenceBreakdown"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "tool_calls": {
        "items": {
          "$ref": "#/$defs/ToolCall"
        },
        "title": "Tool Calls",
        "type": "array"
      },
      "tokens": {
        "default": 0,
        "title": "Tokens",
        "type": "integer"
      },
      "cost_usd": {
        "default": 0.0,
        "title": "Cost Usd",
        "type": "number"
      },
      "duration_ms": {
        "default": 0,
        "title": "Duration Ms",
        "type": "integer"
      }
    },
    "required": [
      "run_id",
      "answer_markdown",
      "code"
    ],
    "title": "AnalysisResult",
    "type": "object"
  },
  "SSEEvent": {
    "description": "Satu event yang di-stream ke frontend selama analisis berjalan.",
    "properties": {
      "type": {
        "enum": [
          "plan",
          "step",
          "tool",
          "chart",
          "verify",
          "confidence",
          "final",
          "error"
