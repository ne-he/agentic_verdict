        "title": "Type",
        "type": "string"
      },
      "data": {
        "title": "Data",
        "type": "object"
      }
    },
    "required": [
      "type"
    ],
    "title": "SSEEvent",
    "type": "object"
  },
  "Scorecard": {
    "description": "Nilai satu run terhadap gold answer (dihasilkan eval harness).",
