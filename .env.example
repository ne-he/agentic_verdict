# ── ANALYST — contoh environment (COMMIT file ini, JANGAN isi key asli) ──
# Copy file ini jadi .env lalu isi nilainya. .env TIDAK di-commit (lihat .gitignore).

# LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Database (SQLite — gratis, gak perlu akun. Supabase TIDAK dipakai.)
DATABASE_URL=sqlite:///./backend/analyst.db

# Sandbox
USE_DOCKER=true
SANDBOX_IMAGE=analyst-sandbox:latest
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MEM_MB=512
SANDBOX_CPUS=2

# Data
DATASETS_DIR=datasets
